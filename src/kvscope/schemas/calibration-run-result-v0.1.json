{
  "$defs": {
    "CalibrationInferenceConfig": {
      "additionalProperties": false,
      "description": "Reproducible inference settings recorded with a peak-memory measurement.",
      "properties": {
        "context_length": {
          "exclusiveMinimum": 0,
          "title": "Context Length",
          "type": "integer"
        },
        "batch_size": {
          "exclusiveMinimum": 0,
          "title": "Batch Size",
          "type": "integer"
        },
        "max_num_seqs": {
          "exclusiveMinimum": 0,
          "title": "Max Num Seqs",
          "type": "integer"
        },
        "active_sequences": {
          "exclusiveMinimum": 0,
          "title": "Active Sequences",
          "type": "integer"
        },
        "prefix_tokens": {
          "minimum": 0,
          "title": "Prefix Tokens",
          "type": "integer"
        },
        "multimodal_tokens": {
          "minimum": 0,
          "title": "Multimodal Tokens",
          "type": "integer"
        },
        "weight_dtype": {
          "minLength": 1,
          "title": "Weight Dtype",
          "type": "string"
        },
        "kv_dtype": {
          "minLength": 1,
          "title": "Kv Dtype",
          "type": "string"
        },
        "graph_capture_enabled": {
          "title": "Graph Capture Enabled",
          "type": "boolean"
        },
        "cpu_offload_bytes": {
          "minimum": 0,
          "title": "Cpu Offload Bytes",
          "type": "integer"
        }
      },
      "required": [
        "context_length",
        "batch_size",
        "max_num_seqs",
        "active_sequences",
        "prefix_tokens",
        "multimodal_tokens",
        "weight_dtype",
        "kv_dtype",
        "graph_capture_enabled",
        "cpu_offload_bytes"
      ],
      "title": "CalibrationInferenceConfig",
      "type": "object"
    },
    "CalibrationMeasurement": {
      "additionalProperties": false,
      "description": "An externally collected, local peak-memory measurement record.",
      "properties": {
        "schema_version": {
          "const": "v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "backend_profile_id": {
          "minLength": 1,
          "title": "Backend Profile Id",
          "type": "string"
        },
        "backend_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Backend Version"
        },
        "hardware_profile_id": {
          "minLength": 1,
          "title": "Hardware Profile Id",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Revision"
        },
        "model_config_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Config Digest"
        },
        "inference_config": {
          "$ref": "#/$defs/CalibrationInferenceConfig"
        },
        "observed_peak_memory_bytes": {
          "exclusiveMinimum": 0,
          "title": "Observed Peak Memory Bytes",
          "type": "integer"
        },
        "measurement_source": {
          "minLength": 1,
          "title": "Measurement Source",
          "type": "string"
        },
        "measurement_method": {
          "minLength": 1,
          "title": "Measurement Method",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notes"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "record_id",
        "collected_at",
        "backend_profile_id",
        "backend_version",
        "hardware_profile_id",
        "model_id",
        "model_revision",
        "model_config_digest",
        "inference_config",
        "observed_peak_memory_bytes",
        "measurement_source",
        "measurement_method",
        "confidence",
        "notes",
        "evidence"
      ],
      "title": "CalibrationMeasurement",
      "type": "object"
    },
    "CalibrationRunFailure": {
      "additionalProperties": false,
      "description": "A non-sensitive failed runner attempt retained in the run result.",
      "properties": {
        "sample_index": {
          "exclusiveMinimum": 0,
          "title": "Sample Index",
          "type": "integer"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "return_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Return Code"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "sample_index",
        "code",
        "return_code",
        "message"
      ],
      "title": "CalibrationRunFailure",
      "type": "object"
    },
    "Confidence": {
      "description": "Confidence levels for estimates and evidence-backed assumptions.",
      "enum": [
        "exact",
        "high",
        "medium",
        "low",
        "unknown"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "A traceable source supporting a profile value or estimate.",
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "source_type": {
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "evidence_id",
        "source_type",
        "source"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Traceable outcome of repeated local observation collection.",
  "properties": {
    "schema_version": {
      "const": "v0.1",
      "default": "v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "manifest_digest": {
      "minLength": 1,
      "title": "Manifest Digest",
      "type": "string"
    },
    "command_digest": {
      "minLength": 1,
      "title": "Command Digest",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "successful_measurements": {
      "items": {
        "$ref": "#/$defs/CalibrationMeasurement"
      },
      "title": "Successful Measurements",
      "type": "array"
    },
    "failures": {
      "items": {
        "$ref": "#/$defs/CalibrationRunFailure"
      },
      "title": "Failures",
      "type": "array"
    },
    "selected_measurement_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Measurement Id"
    },
    "conservative_peak_memory_bytes": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Conservative Peak Memory Bytes"
    },
    "exported_measurement_paths": {
      "items": {
        "type": "string"
      },
      "title": "Exported Measurement Paths",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "kind": {
      "const": "calibration_run_result",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "manifest_digest",
    "command_digest",
    "started_at",
    "completed_at",
    "selected_measurement_id",
    "conservative_peak_memory_bytes",
    "kind"
  ],
  "title": "CalibrationRunResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
