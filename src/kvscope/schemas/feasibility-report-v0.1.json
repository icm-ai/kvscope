{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryFeasibilityReport",
  "type": "object",
  "required": [
    "schema_version",
    "aggregation",
    "feasibility",
    "constraint_analysis"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "moe_weight_analysis": {
      "oneOf": [
        { "$ref": "moe-weight-analysis-v0.1.json" },
        { "type": "null" }
      ]
    },
    "provenance": {
      "type": ["object", "null"],
      "required": [
        "model_id",
        "model_revision",
        "model_config_digest",
        "backend_profile_id",
        "backend_version",
        "hardware_profile_id",
        "inference_config"
      ],
      "properties": {
        "model_id": { "type": "string", "minLength": 1 },
        "model_revision": { "type": ["string", "null"] },
        "model_config_digest": { "type": ["string", "null"] },
        "backend_profile_id": { "type": "string", "minLength": 1 },
        "backend_version": { "type": ["string", "null"] },
        "hardware_profile_id": { "type": "string", "minLength": 1 },
        "inference_config": {
          "type": "object",
          "required": [
            "context_length",
            "batch_size",
            "max_num_seqs",
            "active_sequences",
            "prefix_tokens",
            "multimodal_tokens",
            "weight_dtype",
            "kv_dtype",
            "graph_capture_enabled",
            "cpu_offload_bytes"
          ]
        }
      }
    },
    "aggregation": { "$ref": "memory-requirement-v0.1.json" },
    "feasibility": {
      "type": "object",
      "required": [
        "schema_version",
        "internal_status",
        "product_status",
        "known_subtotal",
        "physical_total_bytes",
        "allocatable_before_headroom",
        "recommended_allocatable",
        "confidence",
        "is_actionable",
        "explanation"
      ],
      "properties": {
        "schema_version": { "type": "string" },
        "internal_status": { "type": "string" },
        "product_status": { "type": "string" },
        "physical_total_bytes": { "type": "integer", "minimum": 0 },
        "confidence": { "type": "string" },
        "is_actionable": { "type": "boolean" },
        "explanation": { "type": "string" }
      }
    },
    "constraint_analysis": {
      "type": "object",
      "required": [
        "schema_version",
        "constraints",
        "confidence"
      ],
      "properties": {
        "schema_version": { "type": "string" },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "severity", "category", "title", "explanation"]
          }
        },
        "confidence": { "type": "string" }
      }
    }
  }
}
