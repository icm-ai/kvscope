{
  "$defs": {
    "ByteRange": {
      "additionalProperties": false,
      "description": "An interval representation of a memory size in bytes.\n\nGuarantees 0 <= lower_bytes <= expected_bytes <= upper_bytes.",
      "properties": {
        "lower_bytes": {
          "minimum": 0,
          "title": "Lower Bytes",
          "type": "integer"
        },
        "expected_bytes": {
          "minimum": 0,
          "title": "Expected Bytes",
          "type": "integer"
        },
        "upper_bytes": {
          "minimum": 0,
          "title": "Upper Bytes",
          "type": "integer"
        }
      },
      "required": [
        "lower_bytes",
        "expected_bytes",
        "upper_bytes"
      ],
      "title": "ByteRange",
      "type": "object"
    },
    "CalibrationComparisonStatus": {
      "description": "Whether an offline comparison could be formed from the source report.",
      "enum": [
        "comparable",
        "incomplete_report",
        "identity_mismatch",
        "identity_unverified"
      ],
      "title": "CalibrationComparisonStatus",
      "type": "string"
    },
    "CalibrationIdentityVerification": {
      "description": "How completely report provenance matches a measurement record.",
      "enum": [
        "verified",
        "partial",
        "mismatch",
        "unavailable"
      ],
      "title": "CalibrationIdentityVerification",
      "type": "string"
    },
    "CalibrationInferenceConfig": {
      "additionalProperties": false,
      "description": "Reproducible inference settings recorded with a peak-memory measurement.",
      "properties": {
        "context_length": {
          "exclusiveMinimum": 0,
          "title": "Context Length",
          "type": "integer"
        },
        "batch_size": {
          "exclusiveMinimum": 0,
          "title": "Batch Size",
          "type": "integer"
        },
        "max_num_seqs": {
          "exclusiveMinimum": 0,
          "title": "Max Num Seqs",
          "type": "integer"
        },
        "active_sequences": {
          "exclusiveMinimum": 0,
          "title": "Active Sequences",
          "type": "integer"
        },
        "prefix_tokens": {
          "minimum": 0,
          "title": "Prefix Tokens",
          "type": "integer"
        },
        "multimodal_tokens": {
          "minimum": 0,
          "title": "Multimodal Tokens",
          "type": "integer"
        },
        "weight_dtype": {
          "minLength": 1,
          "title": "Weight Dtype",
          "type": "string"
        },
        "kv_dtype": {
          "minLength": 1,
          "title": "Kv Dtype",
          "type": "string"
        },
        "graph_capture_enabled": {
          "title": "Graph Capture Enabled",
          "type": "boolean"
        },
        "cpu_offload_bytes": {
          "minimum": 0,
          "title": "Cpu Offload Bytes",
          "type": "integer"
        }
      },
      "required": [
        "context_length",
        "batch_size",
        "max_num_seqs",
        "active_sequences",
        "prefix_tokens",
        "multimodal_tokens",
        "weight_dtype",
        "kv_dtype",
        "graph_capture_enabled",
        "cpu_offload_bytes"
      ],
      "title": "CalibrationInferenceConfig",
      "type": "object"
    },
    "CalibrationMeasurement": {
      "additionalProperties": false,
      "description": "An externally collected, local peak-memory measurement record.",
      "properties": {
        "schema_version": {
          "const": "v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "backend_profile_id": {
          "minLength": 1,
          "title": "Backend Profile Id",
          "type": "string"
        },
        "backend_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Backend Version"
        },
        "hardware_profile_id": {
          "minLength": 1,
          "title": "Hardware Profile Id",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Revision"
        },
        "model_config_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Config Digest"
        },
        "inference_config": {
          "$ref": "#/$defs/CalibrationInferenceConfig"
        },
        "observed_peak_memory_bytes": {
          "exclusiveMinimum": 0,
          "title": "Observed Peak Memory Bytes",
          "type": "integer"
        },
        "measurement_source": {
          "minLength": 1,
          "title": "Measurement Source",
          "type": "string"
        },
        "measurement_method": {
          "minLength": 1,
          "title": "Measurement Method",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notes"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "record_id",
        "collected_at",
        "backend_profile_id",
        "backend_version",
        "hardware_profile_id",
        "model_id",
        "model_revision",
        "model_config_digest",
        "inference_config",
        "observed_peak_memory_bytes",
        "measurement_source",
        "measurement_method",
        "confidence",
        "notes",
        "evidence"
      ],
      "title": "CalibrationMeasurement",
      "type": "object"
    },
    "Confidence": {
      "description": "Confidence levels for estimates and evidence-backed assumptions.",
      "enum": [
        "exact",
        "high",
        "medium",
        "low",
        "unknown"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "A traceable source supporting a profile value or estimate.",
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "source_type": {
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "evidence_id",
        "source_type",
        "source"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "RelativeError": {
      "additionalProperties": false,
      "description": "An exact signed ratio stored as integer numerator and denominator bytes.",
      "properties": {
        "numerator_bytes": {
          "title": "Numerator Bytes",
          "type": "integer"
        },
        "denominator_bytes": {
          "exclusiveMinimum": 0,
          "title": "Denominator Bytes",
          "type": "integer"
        }
      },
      "required": [
        "numerator_bytes",
        "denominator_bytes"
      ],
      "title": "RelativeError",
      "type": "object"
    },
    "SignedByteRange": {
      "additionalProperties": false,
      "description": "An interval representation of a memory difference in integer bytes.\n\nGuarantees lower_bytes <= expected_bytes <= upper_bytes.\nNegative values represent memory deficits; positive values represent headroom.",
      "properties": {
        "lower_bytes": {
          "title": "Lower Bytes",
          "type": "integer"
        },
        "expected_bytes": {
          "title": "Expected Bytes",
          "type": "integer"
        },
        "upper_bytes": {
          "title": "Upper Bytes",
          "type": "integer"
        }
      },
      "required": [
        "lower_bytes",
        "expected_bytes",
        "upper_bytes"
      ],
      "title": "SignedByteRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Auditable comparison of one observed peak against a feasibility report.",
  "properties": {
    "schema_version": {
      "const": "v0.1",
      "default": "v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CalibrationComparisonStatus"
    },
    "measurement_record_id": {
      "minLength": 1,
      "title": "Measurement Record Id",
      "type": "string"
    },
    "report_schema_version": {
      "minLength": 1,
      "title": "Report Schema Version",
      "type": "string"
    },
    "measurement": {
      "$ref": "#/$defs/CalibrationMeasurement"
    },
    "identity_verification": {
      "$ref": "#/$defs/CalibrationIdentityVerification"
    },
    "identity_mismatches": {
      "items": {
        "type": "string"
      },
      "title": "Identity Mismatches",
      "type": "array"
    },
    "predicted_total_requirement": {
      "anyOf": [
        {
          "$ref": "#/$defs/ByteRange"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_peak_memory_bytes": {
      "exclusiveMinimum": 0,
      "title": "Observed Peak Memory Bytes",
      "type": "integer"
    },
    "observed_within_predicted_range": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Observed Within Predicted Range"
    },
    "delta_vs_lower_bytes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Delta Vs Lower Bytes"
    },
    "delta_vs_expected_bytes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Delta Vs Expected Bytes"
    },
    "delta_vs_upper_bytes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Delta Vs Upper Bytes"
    },
    "signed_error": {
      "anyOf": [
        {
          "$ref": "#/$defs/SignedByteRange"
        },
        {
          "type": "null"
        }
      ]
    },
    "relative_error_vs_expected": {
      "anyOf": [
        {
          "$ref": "#/$defs/RelativeError"
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "kind": {
      "const": "calibration_comparison",
      "type": "string"
    }
  },
  "required": [
    "status",
    "measurement_record_id",
    "report_schema_version",
    "measurement",
    "identity_verification",
    "predicted_total_requirement",
    "observed_peak_memory_bytes",
    "observed_within_predicted_range",
    "delta_vs_lower_bytes",
    "delta_vs_expected_bytes",
    "delta_vs_upper_bytes",
    "signed_error",
    "relative_error_vs_expected",
    "confidence"
  ],
  "title": "CalibrationComparison",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
