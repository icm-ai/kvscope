{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KVScope Calibration Record v0.1",
  "description": "A local, externally collected peak-memory measurement. All memory quantities are integer bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "collected_at",
    "backend_profile_id",
    "backend_version",
    "hardware_profile_id",
    "model_id",
    "model_revision",
    "model_config_digest",
    "inference_config",
    "observed_peak_memory_bytes",
    "measurement_source",
    "measurement_method",
    "confidence",
    "notes",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": "v0.1" },
    "record_id": { "type": "string", "minLength": 1 },
    "collected_at": { "type": "string", "format": "date-time" },
    "backend_profile_id": { "type": "string", "minLength": 1 },
    "backend_version": { "type": ["string", "null"] },
    "hardware_profile_id": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "model_revision": { "type": ["string", "null"] },
    "model_config_digest": { "type": ["string", "null"] },
    "inference_config": { "$ref": "#/$defs/inference_config" },
    "observed_peak_memory_bytes": { "type": "integer", "exclusiveMinimum": 0 },
    "measurement_source": { "type": "string", "minLength": 1 },
    "measurement_method": { "type": "string", "minLength": 1 },
    "confidence": {
      "type": "string",
      "enum": ["exact", "high", "medium", "low", "unknown"]
    },
    "notes": { "type": ["string", "null"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    }
  },
  "$defs": {
    "inference_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_length",
        "batch_size",
        "max_num_seqs",
        "active_sequences",
        "prefix_tokens",
        "multimodal_tokens",
        "weight_dtype",
        "kv_dtype",
        "graph_capture_enabled",
        "cpu_offload_bytes"
      ],
      "properties": {
        "context_length": { "type": "integer", "exclusiveMinimum": 0 },
        "batch_size": { "type": "integer", "exclusiveMinimum": 0 },
        "max_num_seqs": { "type": "integer", "exclusiveMinimum": 0 },
        "active_sequences": { "type": "integer", "exclusiveMinimum": 0 },
        "prefix_tokens": { "type": "integer", "minimum": 0 },
        "multimodal_tokens": { "type": "integer", "minimum": 0 },
        "weight_dtype": { "type": "string", "minLength": 1 },
        "kv_dtype": { "type": "string", "minLength": 1 },
        "graph_capture_enabled": { "type": "boolean" },
        "cpu_offload_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_type", "source"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "observed_at": { "type": ["string", "null"], "format": "date-time" },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
